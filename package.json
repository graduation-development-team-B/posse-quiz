{
  "name": "posse-quiz-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:ui": "eslint \"app/(tabs)/index.tsx\" app/scope app/quiz app/feedback app/result components/learning-loop components/home components/scope components/quiz components/feedback components/result styles tests/ui tests/smoke",
    "export:web": "expo export --platform web",
    "test:smoke": "vitest run tests/smoke tests/layout tests/accessibility.test.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/**/*.property.test.ts'",
    "test:pbt": "vitest run --testNamePattern 'PBT|Property' --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest run --passWithNoTests tests/ui tests/smoke/learningLoop.smoke.test.tsx",
    "test:ui:components": "vitest run --passWithNoTests tests/ui/learningLoopComponents.test.tsx",
    "test:ui:home": "vitest run --passWithNoTests tests/ui/homeRefinement.test.tsx",
    "test:ui:scope": "vitest run --passWithNoTests tests/ui/scopeRefinement.test.tsx",
    "test:ui:quiz": "vitest run --passWithNoTests tests/ui/quizRefinement.test.tsx",
    "test:ui:feedback": "vitest run --passWithNoTests tests/ui/feedbackRefinement.test.tsx",
    "test:ui:result": "vitest run --passWithNoTests tests/ui/resultRefinement.test.tsx",
    "test:ui:visual-contract": "vitest run --passWithNoTests tests/ui/visualContract.test.tsx tests/uiux.visual-contract.test.ts",
    "test:ui:smoke": "vitest run --passWithNoTests tests/smoke/learningLoop.smoke.test.tsx",
    "test:ui:all": "vitest run --passWithNoTests tests/ui tests/smoke/learningLoop.smoke.test.tsx",
    "validate:fixture": "node scripts/validate-fixture.js",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.117.0",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "fast-check": "^3.22.0",
    "typescript": "~5.9.2",
    "vitest": "^2.1.9"
  },
  "private": true
}
